# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://jangidvijay840_db_user:<db_password>@aiiotasta.efwwocf.mongodb.net/aiiotasta?retryWrites=true&w=majority&appName=aiiotasta

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ── AI / LLM ─────────────────────────────────────────────
# Primary: Anthropic (Tier 1 - reasoning)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (fallback / routing)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SiliconFlow (code generation tier)
SILICONFLOW_API_KEY=...
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Model selection
AI_REASONING_MODEL=deepseek/deepseek-r1          # circuit planning
AI_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct    # firmware gen
AI_FAST_MODEL=meta-llama/llama-3.2-8b-instruct   # validation

# ── MQTT ─────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Compiler (arduino-cli / PlatformIO) ──────────────────
ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli
PLATFORMIO_PATH=/usr/local/bin/pio
COMPILE_TIMEOUT_MS=60000
COMPILE_TEMP_DIR=/tmp/aiot-compile

# ── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
