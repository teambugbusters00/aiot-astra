# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://jangidvijay840_db_user:<db_password>@aiiotasta.efwwocf.mongodb.net/aiiotasta?retryWrites=true&w=majority&appName=aiiotasta

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ── AI / LLM / PROVIDERS ──────────────────────────────────
# NVIDIA AI Endpoints (Tier 1/2 reasoning + code)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter (fallback / routing)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (Tier 3 fast validation/extraction)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model selection
# AI_REASONING_MODEL=meta/llama-3.3-70b-instruct
AI_REASONING_MODEL=meta/llama-3.1-8b-instruct
AI_CODE_MODEL=qwen/qwen2.5-coder-32b-instruct
AI_FAST_MODEL=llama-3.1-8b-instant

# ── MQTT ─────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Compiler (arduino-cli / PlatformIO) ──────────────────
ARDUINO_CLI_PATH=/usr/local/bin/arduino-cli
PLATFORMIO_PATH=/usr/local/bin/pio
COMPILE_TIMEOUT_MS=60000
COMPILE_TEMP_DIR=/tmp/aiot-compile

# ── File Storage ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
